# ==============================================================================
# NAPS HR Apprentice Lifecycle & Email Scheduling System - Environment Configuration
# ==============================================================================
# Copy this file to .env or configure these variables in your Vercel Project Settings:
# https://vercel.com/dashboard -> Project -> Settings -> Environment Variables
#
# IMPORTANT: Never commit files containing real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PERSISTENT DATABASE CONFIGURATION (CRITICAL FOR VERCEL)
# ------------------------------------------------------------------------------
# Vercel Serverless Functions have an ephemeral filesystem; SQLite files do not persist.
# Configure a cloud-hosted PostgreSQL database connection string (e.g. Neon, Supabase, Vercel Postgres):
# Examples:
#   DATABASE_URL=postgresql://username:password@ep-cool-frog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#   DATABASE_URL=postgresql://postgres:password@db.xyz.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@your-cloud-postgres-host:5432/neondb?sslmode=require

# SQLite fallback path (used automatically only when DATABASE_URL is not set, e.g. local testing):
NAPS_DB_PATH=naps_trainees.db

# ------------------------------------------------------------------------------
# 2. ADMINISTRATOR AUTHENTICATION (SINGLE-USER PORTAL)
# ------------------------------------------------------------------------------
# Configure secure administrator credentials for the administrative portal:
NAPS_ADMIN_USERNAME=admin
NAPS_ADMIN_EMAIL=admin@yourcompany.com
NAPS_ADMIN_PASSWORD=ChangeThisToAStrongUniquePassword123!

# Cryptographic secret for signing session tokens (generate a random 32+ character string):
SESSION_SECRET=generate_a_random_secure_32_character_hex_string_here

# ------------------------------------------------------------------------------
# 3. BACKGROUND SCHEDULING (VERCEL CRON)
# ------------------------------------------------------------------------------
# Shared secret for securing the /api/cron/dispatch endpoint:
# Vercel Cron automatically includes this secret when configured.
CRON_SECRET=generate_a_random_cron_secret_here

# ------------------------------------------------------------------------------
# 4. EMAIL DELIVERY SAFETY & STRICT SIMULATION MODE
# ------------------------------------------------------------------------------
# SAFETY LOCK: The email system is configured in SIMULATION MODE by default.
# All milestone calculations, date adjustments, and recipient resolution execute,
# and simulated dispatch records are saved in the database without connecting to SMTP.
#
# To strictly prevent accidental external email transmission:
#   ENABLE_LIVE_EMAIL_SENDING: must be 'true' AND EMAIL_DRY_RUN must be 'false'
#   to ever attempt live SMTP dispatch.
ENABLE_LIVE_EMAIL_SENDING=false
EMAIL_DRY_RUN=true

# ------------------------------------------------------------------------------
# 5. SMTP SERVER CONFIGURATION (INACTIVE IN SIMULATION MODE)
# ------------------------------------------------------------------------------
# SMTP credentials are kept disabled and ignored while simulation mode is active.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=hr.notifications@yourcompany.com
DEFAULT_FROM_EMAIL=hr.notifications@yourcompany.com
SMTP_PASSWORD=your_16_character_app_password_here
